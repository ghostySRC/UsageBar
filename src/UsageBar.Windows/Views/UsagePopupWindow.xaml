<Window x:Class="UsageBar.Windows.Views.UsagePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageBar" Width="390" SizeToContent="Height" MaxHeight="680"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="True"
        Topmost="True" WindowStartupLocation="Manual" Deactivated="OnDeactivated">
  <Window.Resources>
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.16" />
  </Window.Resources>
  <Border Margin="8" Padding="18,15,18,13" CornerRadius="14"
          Background="{DynamicResource SurfaceBrush}" BorderBrush="#2A808080" BorderThickness="1"
          Effect="{DynamicResource PopupShadow}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
        <Button DockPanel.Dock="Right" Content="×" FontSize="19" Padding="7,0" Width="32" Height="30"
                ToolTip="Close" Click="Close_Click" />
        <StackPanel>
          <TextBlock Text="UsageBar" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Current account limits" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
      </DockPanel>

      <StackPanel Grid.Row="1">
        <TextBlock x:Name="EmptyText" Text="{Binding EmptyMessage}" Margin="0,2,0,10" FontSize="12"
                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Providers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="0,10,0,8" BorderBrush="#25808080" BorderThickness="0,1,0,0">
                <StackPanel>
                  <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LastUpdated}" FontSize="10"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{Binding StatusColor}" />
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                  </DockPanel>
                  <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                             Margin="14,0,0,8" />
                  <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="14,0,0,9" ToolTip="{Binding ToolTip}">
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Margin="0,0,0,5" />
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="5-hour" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                  <Run Text="{Binding FiveHourUsed}" />
                                  <Run Text=" used · " />
                                  <Run Text="{Binding FiveHourRemaining}" />
                                  <Run Text=" left" />
                                </TextBlock>
                                <ProgressBar Value="{Binding FiveHourProgress}" Maximum="100"
                                             Visibility="{Binding ShowProgressBars, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             IsIndeterminate="False" />
                                <TextBlock Text="{Binding FiveHourReset, StringFormat='Resets {0}'}" FontSize="10"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                              </StackPanel>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="Weekly" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                  <Run Text="{Binding WeeklyUsed}" />
                                  <Run Text=" used · " />
                                  <Run Text="{Binding WeeklyRemaining}" />
                                  <Run Text=" left" />
                                </TextBlock>
                                <ProgressBar Value="{Binding WeeklyProgress}" Maximum="100"
                                             Visibility="{Binding ShowProgressBars, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             IsIndeterminate="False" />
                                <TextBlock Text="{Binding WeeklyReset, StringFormat='Resets {0}'}" FontSize="10"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                              </StackPanel>
                            </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,5,0,0">
        <Button Content="Refresh" Click="Refresh_Click" />
        <Button Content="Settings" Click="Settings_Click" />
        <Button Content="Launch Codex" Visibility="{Binding ShowLaunchCodex, Converter={StaticResource BooleanToVisibilityConverter}}"
                Click="LaunchCodex_Click" />
        <Button Content="Launch Antigravity" Visibility="{Binding ShowLaunchAntigravity, Converter={StaticResource BooleanToVisibilityConverter}}"
                Click="LaunchAntigravity_Click" />
        <Button Content="Exit" Click="Exit_Click" />
      </WrapPanel>
    </Grid>
  </Border>
</Window>
